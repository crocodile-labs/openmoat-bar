{
  "secrets": [
    {
      "id": "dev-api",
      "host": "localhost",
      "header": "Authorization",
      "source": {
        "env": "DEV_API_TOKEN"
      },
      "plain_http": true,
      "port": 8080,
      "source_exposed": false
    },
    {
      "id": "internal",
      "host": "build.internal.example",
      "header": "X-Api-Key",
      "source": {
        "keychain": {
          "service": "build-api",
          "account": "you"
        }
      },
      "plain_http": true,
      "source_exposed": false
    }
  ]
}
