{
  "secrets": [
    {
      "id": "gh",
      "host": "api.github.com",
      "header": "Authorization",
      "source": {
        "env": "GITHUB_TOKEN"
      },
      "source_exposed": true
    },
    {
      "id": "openai",
      "host": "api.openai.com",
      "header": "Authorization",
      "source": {
        "file": "~/.config/openai/key"
      },
      "source_exposed": false
    },
    {
      "id": "internal",
      "host": "build.internal.example",
      "header": "X-Api-Key",
      "source": {
        "keychain": {
          "service": "build-api",
          "account": "you"
        }
      },
      "plain_http": true,
      "source_exposed": false
    },
    {
      "id": "future",
      "host": "api.example.com",
      "header": "Authorization",
      "source": {
        "vault": "kv/api"
      },
      "source_exposed": false
    }
  ]
}
